  "audio": {
    "bgmVolume": 0.32,
    "narrationTail": 0.55,
    "bgmFadeIn": 1.2,
    "bgmFadeOut": 1.8,
    "targetLoudness": -16,
    "truePeak": -1.5,
    "cuePreset": "dossier"
  },
  "captions": {
    "position": "bottom-center",
    "baseline": 1392,
    "maxCharsPerCue": 15,
    "maxLines": 1,
    "backdrop": "rgba(24,24,22,0.92)",
    "textColor": "#F4EEE0",
    "leadIn": 0.12,
    "leadOut": 0.35
  },
  "layout": {
    "header": { "left": 72, "top": 72 },
    "headerRule": { "left": 72, "right": 72, "top": 116 },
    "footerRule": { "top": 1628 },
    "footer": { "left": 72, "top": 1648 },
    "safeArea": { "top": 170, "bottom": 1560 },
    "columnRule": { "x": 540 }
  },
  "negative": [
    "3D 渲染感、塑料光泽、玻璃拟态",
    "赛博霓虹、紫蓝渐变、发光描边",
    "人物表情表演、漫剧分格、Q 版角色",
    "无来源的具体数字（播放量/粉丝数/增长率）",
    "证物框内放无授权图片或 AI 伪造的『现场照片』",
    "印章当装饰反复盖",
    "账号名、频道名、Logo、水印"
  ],
  "styleLock": [
    "只有四色：墨 / 纸 / 卡纸 / 朱红",
    "印章只用在『定性』与『结论』两个时机",
    "红线只表示『来源 → 结论』，不做装饰",
    "竖屏字幕基线 y=1392（1080×1920），一行 10–15 字",
    "没有可靠来源时禁止出现具体数字，只能做示意并标注"
  ],
  "hardRules": [
    "只用四种颜色：墨、纸、卡纸、朱红",
    "印章只在两种时机出现：定性（均为非遗）与结论（已核实）",
    "证物框内不得放无授权图片；无素材时用抽象条纹 + EVIDENCE 编号占位",
    "无可靠来源时禁止出现具体数字（播放量、粉丝数、增长率）",
    "红线只用于'来源→结论'的指向，不能当装饰",
    "字幕按人工写好的行切分，一行 10–15 字"
  ]
}
