{
  "$schema": "./style.schema.json",
  "id": "paper-editorial",
  "name": "纸感编辑风（SERIF / PAPER）",
  "category": "editorial",
  "description": "暖白纸纹 + 宋体大字 + 朱红印章。适合人文、历史、心理、社科类知识视频。最不像 AI 生成的一档。",
  "canvas": {
    "aspectRatio": "16:9",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safeMargin": 140
  },
  "palette": {
    "ink": "#1C1814",
    "paper": "#F2EDE3",
    "muted": "#8A7F6E",
    "accent": "#B23A2F",
    "rule": "rgba(28,24,20,0.28)"
  },
  "typography": {
    "display": {
      "family": "serif",
      "size": 122,
      "weight": 700,
      "leading": 1.28,
      "track": "0.02em"
    },
    "h1": {
      "family": "serif",
      "size": 74,
      "weight": 700,
      "leading": 1.4,
      "track": "0.02em"
    },
    "h2": {
      "family": "serif",
      "size": 44,
      "weight": 700,
      "leading": 1.5,
      "track": "0.02em"
    },
    "body": {
      "family": "serif",
      "size": 33,
      "weight": 500,
      "leading": 1.75,
      "track": "0.02em"
    },
    "caption": {
      "family": "serif",
      "size": 36,
      "weight": 700,
      "leading": 1.5,
      "track": "0.02em"
    },
    "kicker": {
      "family": "mono",
      "size": 22,
      "weight": 500,
      "leading": 1.2,
      "track": "0.24em"
    }
  },
  "fonts": {
    "serif": "\"Source Han Serif SC\", \"Noto Serif SC\", \"SimSun\", serif",
    "sans": "\"Noto Sans SC\", \"Microsoft YaHei\", system-ui, sans-serif",
    "mono": "\"Cascadia Mono\", \"Consolas\", ui-monospace, monospace"
  },
  "motion": {
    "reveal": {
      "type": "clip-rise",
      "duration": 30,
      "distance": 18,
      "curve": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "standard": {
      "curve": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "exit": {
      "curve": [
        0.4,
        0,
        1,
        1
      ]
    },
    "stagger": 5,
    "springSoft": {
      "damping": 200,
      "mass": 0.6,
      "stiffness": 90
    },
    "springSnap": {
      "damping": 24,
      "mass": 0.5,
      "stiffness": 220
    },
    "maxOvershoot": 1.06
  },
  "postEffects": {
    "grain": 0.045,
    "vignette": 0.3,
    "bloom": 0.1,
    "aberration": 0.002,
    "paperTexture": 0.13
  },
  "audio": {
    "bgmVolume": 0.22,
    "narrationTail": 0.55,
    "bgmFadeIn": 2.0,
    "bgmFadeOut": 2.5,
    "targetLoudness": -16,
    "truePeak": -1.5
  },
  "captions": {
    "position": "bottom-center",
    "bottom": 132,
    "maxCharsPerCue": 22,
    "maxLines": 2,
    "backdrop": "rgba(28,24,20,0.055)",
    "leadIn": 0.55
  },
  "layout": {
    "header": {
      "left": 140,
      "top": 96
    },
    "rule": {
      "left": 140,
      "right": 140,
      "top": 150
    },
    "footer": {
      "left": 140,
      "bottom": 74
    },
    "seal": {
      "size": 148,
      "right": 168,
      "top": 210,
      "rotate": -3
    }
  },
  "negative": [
    "3D 渲染感、塑料光泽、玻璃拟态卡片堆叠",
    "赛博霓虹、紫蓝渐变、发光描边",
    "人物表情表演、漫剧分格、Q 版角色",
    "与内容无关的粒子雨、光斑乱飘",
    "整屏大写的英文口号、无信息量的装饰英文",
    "截图或网图冒充证据（证物框只放有授权的素材）",
    "账号名、频道名、Logo、水印",
    "高频刺耳音效、盖过旁白的配乐"
  ],
  "styleLock": [
    "色板 ≤3 色：墨 / 纸 / accent，accent 只给信息焦点",
    "禁止 linear 曲线；过冲 ≤1.06",
    "颗粒 4–5%、暗角 0.3、泛光 0.1，超出即廉价",
    "全片共用一套页眉/分栏线/页脚锚点，不逐幕重摆",
    "字幕 ≤22 字、≤2 行，人工断行，句末不加句号"
  ],
  "roadmap": {
    "note": "同一套 token 结构可承载其他风格；新增风格只加一个 JSON，不改组件。",
    "plannedStyles": [
      "swiss-editorial-dark（深色瑞士排版，单一 accent）",
      "data-cold（深蓝数据风，大字数字 + 折线生长）",
      "whiteboard（白板手绘，参考 huashu-art-motion / sweety-handdraw-video）",
      "vox-explainer（Vox 式图解，参考 huashu-art-motion）",
      "math-3b1b（3Blue1Brown 式推导，Manim 路线）",
      "pixel-story（像素叙事，参考 anidoodle / ClaudeAnimationBase）",
      "ink-wash（水墨，参考 anidoodle 32 风格 / lemo-opuscar 66 模板）",
      "paper-cut（剪纸，参考 cth9191/animate 7 风格）",
      "blueprint（蓝图线稿，参考 anidoodle）",
      "handdrawn（铅笔/粉笔手绘，参考 anidoodle）"
    ]
  }
}